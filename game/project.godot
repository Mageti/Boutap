; Boutap 	le projet Godot.
;
; Ce fichier est la SEULE entree de Godot dans le depot. Il ne contient aucune
; logique : tout le comportement est dans src/*.cs, assemble par
; Boutap.Shell.csproj. Godot 4.7 ecrit ce fichier avec des tabulations, et
; `.editorconfig` l'exige aussi : c'est la seule exception a la regle
; « pas de tabulation en debut de ligne » (voir scripts/check-format.sh).
;
; R1 : ce fichier ne lit aucune horloge.

config_version=5

[application]

config/name="Boutap"
config/description="Jouer du rythme aux pieds et aux mains."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[audio]

; Regle C7 : la latence de bout en bout doit tenir sous 25 ms. La valeur
; reellement obtenue peut etre contrainte par l'hote, donc on epingle la
; valeur DEMANDEE a sa valeur par defaut (15 ms) plutot que de la laisser
; deriver avec une version du moteur, et on mesure ce qu'on obtient avec
; AudioServer.GetOutputLatency() dans la coque. Baisser ce nombre reduit la
; latence et augmente le risque de craquement : ce n'est pas un reglage a
; toucher sans mesure.
driver/output_latency=15

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Boutap.Shell"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
