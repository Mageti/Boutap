  SPDX-License-Identifier: AGPL-3.0-or-later

  Tests de Boutap.Gen. Le projet de test vit a cote du projet teste (wiki: decision D1)
  pour que la liste des assemblies soit lisible en un coup d'oeil.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Boutap.Gen.Tests</RootNamespace>
    <AssemblyName>Boutap.Gen.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boutap.Gen\Boutap.Gen.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Boutap.Core\Boutap.Core.csproj" />
  </ItemGroup>

  <!-- Boutap.Audio n'est pas une dependance de Boutap.Gen : seul le test en a
       besoin, pour sortir l'audio du pack de demonstration sans dupliquer le
       WAV dans les donnees de test. -->
  <ItemGroup>
    <ProjectReference Include="..\Boutap.Audio\Boutap.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Boutap.Core.Tests\TestPaths.cs" Link="TestPaths.cs" />
  </ItemGroup>

</Project>
