# ─────────────────────────────────────────────────────────────────────────────
# Boutap — jeu de rythme à neuf touches
# https://github.com/<org>/boutap
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & variables locales ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.local
secrets.*

# ── .NET / C# ───────────────────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
*.userprefs
*.csproj.user
project.lock.json
artifacts/
TestResults/
*.trx
*.coverage
*.coverlet.json
.vs/
BenchmarkDotNet.Artifacts/

# ── Godot 4 ─────────────────────────────────────────────────────────────────
# Cache d'import et métadonnées générées : jamais versionnées.
.godot/
.import/
# Godot 3 legacy, gardé par sécurité.
export.cfg
# export_presets.cfg est volontairement ABSENT de cette liste : les presets
# d'export sont des entrees de build, pas un reglage local. La CI les lit pour
# produire les 4 cibles, donc un changement de preset est un changement de
# contrat et doit passer en revue.
*.translation

# ── Build / exports ─────────────────────────────────────────────────────────
/build/
/dist/
/out/
/export/
*.apk
*.aab
*.pck
*.AppImage
*.appimage
*.exe
*.msi
*.deb
*.rpm
*.flatpak
*.flatpakref
*.tar.gz
# Les sommes de_checksum des livrables ne sont pas versionnees, mais les
# fichiers d'or du generateur (tests/goldens.sha256) DOIVENT l'etre.
*.sha256
!tests/goldens.sha256

# ── Données utilisateur & tests locaux (jamais versionnées) ─────────────────
/userdata/
/logs/
/songs/local/
/packs/local/
*.tmp
*.bak
# Repertoire temporaire des tests en CI (voir .github/workflows/ci.yml).
/.tmp-tests/
# Caches de travail partages, montes par scripts/dev.sh hors de /src.
# Vides et recrees a la demande, jamais versionnes.
/.cache/
# Worktrees CodeNomad, propres a l'outillage de poste de travail.
/.codenomad/

# ── Python : sonde de recherche (tools/probe) ───────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Documentation générée (mkdocs) ──────────────────────────────────────────
/site/

# ── OS / éditeurs ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
.fleet/
