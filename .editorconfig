# ─────────────────────────────────────────────────────────────────────────────
# Boutap — conventions d'édition (.editorconfig)
# https://editorconfig.org
# ─────────────────────────────────────────────────────────────────────────────
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ── C# / .NET ───────────────────────────────────────────────────────────────
[*.cs]
indent_size = 4
max_line_length = 120
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion

# ── Fichiers projet .NET ────────────────────────────────────────────────────
[*.{csproj,props,targets,sln}]
indent_size = 2

# ── Godot ───────────────────────────────────────────────────────────────────
[*.{gd,tscn,tres,godot,cfg}]
indent_size = 4
indent_style = tab

# ── Python (sonde de recherche) ─────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 100

# ── JSON ────────────────────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_size = 2

# ── YAML ────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── Markdown : ne jamais couper les deux espaces de fin de ligne ────────────
# (break-hard en Markdown) ni les lignes de tableau.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ── Fichiers générés / vendors : hors contrôle ─────────────────────────────
[*.{pck,btp,ogg,opus,wav,flac,mp3,png,jpg,webp,ttf,otf,woff,woff2}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset

[*.godot-export/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
